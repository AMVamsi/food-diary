#!/bin/bash
set -e

COMMIT_MSG_FILE="$1"
if [ -z "$COMMIT_MSG_FILE" ]; then
  COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
fi

COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null || echo "")

# Auto-pass merge commits
if echo "$COMMIT_MSG" | grep -qiE "^Merge (pull request|branch|remote|tag)"; then
  echo "  Merge commit — AI_USAGE.md check skipped."
  exit 0
fi

# Auto-pass Copilot review suggestion commits
if echo "$COMMIT_MSG" | grep -qiE "^Apply suggestions? from code review"; then
  echo "  Copilot review suggestion commit — treated as [log:copilot], check skipped."
  exit 0
fi

# Extract [log:slug] token
SLUG=$(echo "$COMMIT_MSG" | grep -oE '\[log:[a-zA-Z0-9_-]+\]' | head -1 | sed 's/\[log://;s/\]//')

if [ -z "$SLUG" ]; then
  echo ""
  echo "  Commit blocked — no [log:slug] token found in commit message."
  echo ""
  echo "  Add a token to your commit message:"
  echo "    feat: my change (#12) [log:my-slug]"
  echo ""
  echo "  For manual-only changes:   [log:manual]"
  echo "  For Copilot-assisted:      [log:copilot]"
  echo ""
  exit 1
fi

# Check AI_USAGE.md for a matching row
if grep -q "| $SLUG " AI_USAGE.md; then
  echo "  AI_USAGE.md check passed for slug '$SLUG'."
else
  echo ""
  echo "  Commit blocked — no AI_USAGE.md entry for slug '$SLUG'."
  echo ""
  echo "  Add this row to AI_USAGE.md:"
  echo "  | $SLUG | $(date +%Y-%m-%d) | Tool | #issue | file(s) | what was generated | how verified | modifications |"
  echo ""
  exit 1
fi